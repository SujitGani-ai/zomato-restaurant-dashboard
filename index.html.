const $ = id => document.getElementById(id);
const fmt = n => Number(n||0).toLocaleString('en-IN');
const money = n => '₹'+fmt(Math.round(n||0));
const avg = a => a.length ? a.reduce((s,x)=>s+x,0)/a.length : 0;
const types = [...new Set(DATA.map(d=>d.type))].sort();
types.forEach(t=>{let o=document.createElement('option');o.value=t;o.textContent=t;$('type').append(o)});
function filtered(){return DATA.filter(d=>
 (! $('search').value || d.name.toLowerCase().includes($('search').value.toLowerCase())) &&
 (! $('type').value || d.type===$('type').value) &&
 (! $('online').value || d.online===$('online').value) &&
 (! $('booking').value || d.booking===$('booking').value) &&
 (Number($('rating').value)===0 || (d.rating!==null && d.rating>=Number($('rating').value))) &&
 d.cost<=Number($('cost').value)
)}
function barRows(el, entries, max){$(el).innerHTML=entries.map(([label,val])=>`<div class="barrow"><span>${label}</span><div class="track"><div class="fill" style="width:${max?val/max*100:0}%"></div></div><b>${val}</b></div>`).join('')||'<div class="empty">No data for current filters</div>'}
function donut(id,pctId,keyId,yes,no,color){let total=yes+no,pct=total?yes/total*100:0;$(id).style.background=`conic-gradient(${color} 0 ${pct}%, #f1dfe2 ${pct}% 100%)`;$(pctId).innerHTML=`${pct.toFixed(0)}%<small>YES</small>`;$(keyId).innerHTML=`<div><span class="dot" style="background:${color}"></span>Yes <b>${yes}</b></div><div><span class="dot" style="background:#f1dfe2"></span>No <b>${no}</b></div><div style="color:#8993a1">${total} restaurants</div>`}
function render(){
 const a=filtered(), rated=a.filter(d=>d.rating!==null), costs=a.map(d=>d.cost), votes=a.reduce((s,d)=>s+d.votes,0);
 $('resultCount').textContent=`${a.length} of ${DATA.length} records`;
 $('kTotal').textContent=fmt(a.length);$('kRating').textContent=rated.length?avg(rated.map(d=>d.rating)).toFixed(2)+'/5':'—';
 $('kCost').textContent=costs.length?money(avg(costs)):'—';$('kVotes').textContent=fmt(votes);
 const bands=[['Below 3.0',0,2.999],['3.0–3.4',3,3.499],['3.5–3.9',3.5,3.999],['4.0–4.4',4,4.499],['4.5+',4.5,5]];
 const dist=bands.map(([n,l,h])=>[n,rated.filter(d=>d.rating>=l&&d.rating<=h).length]);barRows('ratingBars',dist,Math.max(1,...dist.map(x=>x[1])));
 const tc=types.map(t=>[t,a.filter(d=>d.type===t).length]);barRows('typeBars',tc,Math.max(1,...tc.map(x=>x[1])));
 const cb=[['≤₹300',0,300],['₹301–500',301,500],['₹501–800',501,800],['₹801–1200',801,1200],['>₹1200',1201,Infinity]];
 const ce=cb.map(([n,l,h])=>{let q=a.filter(d=>d.cost>=l&&d.cost<=h&&d.rating!==null);return [n,q.length?avg(q.map(d=>d.rating)).toFixed(2):'—']});
 $('costBars').innerHTML=ce.map(([n,v])=>`<div class="barrow"><span>${n}</span><div class="track"><div class="fill" style="width:${v==='—'?0:Number(v)/5*100}%"></div></div><b>${v}</b></div>`).join('');
 let oy=a.filter(d=>d.online==='Yes').length,on=a.length-oy;donut('onlineDonut','onlinePct','onlineKey',oy,on,'#e23d4f');
 let by=a.filter(d=>d.booking==='Yes').length;donut('bookingDonut','bookingPct','bookingKey',by,a.length-by,'#169b83');
 const top=[...rated].sort((x,y)=>y.rating-x.rating||y.votes-x.votes).slice(0,8);
 $('topRows').innerHTML=top.map(d=>`<tr><td><b>${esc(d.name)}</b></td><td>${esc(d.type)}</td><td class="rating">${d.rating.toFixed(1)}/5</td><td>${fmt(d.votes)}</td><td>${money(d.cost)}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">No rated restaurants match</td></tr>';
 $('allRows').innerHTML=a.map(d=>`<tr><td><b>${esc(d.name)}</b></td><td>${esc(d.type)}</td><td class="rating">${d.rating===null?'—':d.rating.toFixed(1)+'/5'}</td><td>${fmt(d.votes)}</td><td>${money(d.cost)}</td><td><span class="pill ${d.online==='No'?'no':''}">${d.online}</span></td><td><span class="pill ${d.booking==='No'?'no':''}">${d.booking}</span></td></tr>`).join('')||'<tr><td colspan="7" class="empty">No restaurants match the selected filters</td></tr>';
