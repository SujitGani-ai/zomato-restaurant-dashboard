}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
['search','type','rating','cost','online','booking'].forEach(id=>$(id).addEventListener(id==='search'?'input':'change',render));
$('reset').onclick=()=>{['search','type','online','booking'].forEach(id=>$(id).value='');$('rating').value='0';$('cost').value='999999';render()};
$('export').onclick=()=>{let a=filtered(),headers=['Restaurant','Online order','Table booking','Rating','Votes','Approx cost for two','Restaurant type'];let rows=a.map(d=>[d.name,d.online,d.booking,d.rating??'',d.votes,d.cost,d.type]);let csv=[headers,...rows].map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\r\n');let blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'});let url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download='zomato_filtered_restaurants.csv';link.click();URL.revokeObjectURL(url)};
